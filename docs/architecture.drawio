        <mxCell id="e-hub-otlp" value="optional" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;html=1;endArrow=classic;endFill=1;strokeColor=#9aa5b1;fontSize=8;fontColor=#7b8794;labelBackgroundColor=#ffffff;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="hub" target="be-otlp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-metrics-hmi" value="PromQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#9aa5b1;fontSize=8;fontColor=#7b8794;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="be-metrics" target="be-hmi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-traces-hmi" value="trace API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#9aa5b1;fontSize=8;fontColor=#7b8794;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="be-traces" target="be-hmi">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1420" y="269" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- ============ callout ============ -->
        <mxCell id="callout" value="&lt;b&gt;OTel-native:&lt;/b&gt; no ActiveGate, no OneAgent. The collectors &lt;i&gt;are&lt;/i&gt; the agents, and every backend is reached over OTLP." style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#1f2933;html=1;fontSize=10;fontColor=#1f2933;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="756" width="1410" height="34" as="geometry" />
        </mxCell>

        <!-- ============ footer ============ -->
        <mxCell id="footer" value="Solid = started by &lt;code&gt;make up&lt;/code&gt; · dashed = optional, not in the default path.    Blue = charging site · green = generation site · purple = microgrid · navy = OpenTelemetry Collector · amber = impaired WAN.&#10;poll = the poller is the Modbus master: it requests and the meter answers — devices never push. The edge collector is the site's only egress and stamps &lt;code&gt;energy.site.id&lt;/code&gt;, &lt;code&gt;energy.site.kind&lt;/code&gt; and &lt;code&gt;geo.latitude/longitude&lt;/code&gt; on every signal, so the map needs no knowledge of the sites." style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontColor=#7b8794;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="798" width="1410" height="58" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

        <!-- ============ callout ============ -->
        <mxCell id="callout" value="&lt;b&gt;OTel-native:&lt;/b&gt; no ActiveGate, no OneAgent. The collectors &lt;i&gt;are&lt;/i&gt; the agents. Every backend is reached over OTLP and nothing else." style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#1f2933;html=1;fontSize=10;fontColor=#1f2933;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="730" y="598" width="480" height="50" as="geometry" />
        </mxCell>

        <!-- ============ footer ============ -->
        <mxCell id="footer" value="Solid border = running today (M1a) · dashed = planned.    Blue = OpenTelemetry Collector · green = generation site · amber = impaired WAN.&#10;poll = the poller is the Modbus master: it requests and the meter answers — devices never push. OpenTelemetry has no Modbus receiver, so the poller is a separate process; the edge collector is still the only thing northbound, and it stamps energy.site.id, energy.site.kind and geo.latitude/longitude on every signal so the map needs no knowledge of the sites." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#7b8794;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="1170" height="54" as="geometry" />
        </mxCell>
      </root>
